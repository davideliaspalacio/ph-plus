###############################################################################
# PH PLUS — Environment variables
###############################################################################
# Copia este archivo a `.env.local` y completá los valores REALES. NO commitees
# `.env.local` — está en .gitignore. Para Vercel, configurá estos mismos valores
# en Settings → Environment Variables.
###############################################################################

# ─── Backend selector ────────────────────────────────────────────────────────
# "mock"     → todo en memoria + localStorage (default, sirve para demo offline)
# "supabase" → usa el proyecto Supabase configurado abajo
NEXT_PUBLIC_DATA_BACKEND=mock

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Conseguilas en Supabase Dashboard → Project Settings → API.
#
# NEXT_PUBLIC_* se exponen al browser — eso está bien para anon key (es la key
# pública pensada para clientes con RLS activo). Acepta tanto el formato
# moderno `sb_publishable_*` como el legacy JWT `eyJhbGc...`; ambos van en la
# misma variable NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# SUPABASE_SERVICE_ROLE_KEY NUNCA va con NEXT_PUBLIC_. Solo se usa en server
# components, route handlers, server actions y edge functions. Bypassea RLS,
# tratala como una clave de admin: si se filtra, cualquier persona puede leer
# y modificar todo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_KEEP_SECRET

# ─── Site URL ────────────────────────────────────────────────────────────────
# Usada para construir links absolutos en emails (recover password, etc).
# En dev: http://localhost:3000
# En Vercel preview: la URL del preview deployment
# En prod: https://www.ph-plus.co (o tu dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Correo transaccional ────────────────────────────────────────────────────
# Por ahora sólo se usa para avisar "nuevo pedido pagado" (webhook de Rapyd →
# app/lib/correos/pedido-pagado.ts). Opcional: sin llaves, el pago se procesa
# igual y sólo se loguea que el correo no salió.
#
# Proveedor: ZeptoMail si están ZEPTOMAIL_API_KEY + CORREO_REMITENTE; si no,
# Resend si está RESEND_API_KEY. Ambas llaves son SECRETAS (no NEXT_PUBLIC_).
#
# ZeptoMail (definitivo): exige dominio verificado (DKIM + CNAME bounce-zem).
# CORREO_REMITENTE tiene que ser de ese dominio — con Gmail o *.vercel.app,
# Zoho rechaza. El token es el Send Mail Token, con o sin "Zoho-enczapikey".
# ZEPTOMAIL_API_KEY=Zoho-enczapikey XXXXXXXXXXXX
# CORREO_REMITENTE="PH PLUS <noreply@ph-plus.co>"
#
# Resend (puente sin dominio): manda desde onboarding@resend.dev y SÓLO al
# correo dueño de la cuenta de Resend. RESEND_FROM_EMAIL sólo cuando haya un
# dominio verificado en Resend.
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXX
# RESEND_FROM_EMAIL="PH PLUS <noreply@ph-plus.co>"
#
# CORREO_RESPUESTA=hola@ph-plus.co
# Destinatario del aviso de pedido pagado (default: davideliaspalacioo@gmail.com)
# CORREO_PEDIDOS=comercial2@aguaphplus.com

# ─── Pasarela de pago: Wompi (activa) ────────────────────────────────────────
# Reemplaza a Rapyd (oct/2026). Flujo: se crea un Payment Link con la llave
# PRIVADA (app/lib/wompi-server.ts), el comprador paga en checkout.wompi.co y
# vuelve a /checkout/wompi/respuesta/<orderId>?id=<transacción>. El estado de
# la orden SIEMPRE se re-consulta a Wompi, nunca se confía en la URL ni en el
# body del webhook.
#
# El ambiente se deduce del prefijo de la llave pública: pub_test_ = sandbox,
# pub_prod_ = producción (la privada debe ser prv_test_ / prv_prod_ a juego).
# WOMPI_PRIVATE_KEY es secreta: NO usar NEXT_PUBLIC_.
#
# WOMPI_EVENTS_SECRET (Wompi -> Desarrollo -> Secretos para integración
# técnica -> "Secreto de eventos") es opcional: si está, se valida el checksum
# de los webhooks. En el panel de Wompi, configurá la "URL de eventos" a
#   https://<tu-dominio>/api/payments/wompi/webhook
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Pasarela de pago (legacy): Rapyd Hosted Checkout Page ────────────────────────────
# Ya no está wireada en el checkout (se reemplazó por Wompi) — se deja por
# si hace falta volver atrás.
# El código de PayU (app/lib/payu-server.ts, app/api/payments/payu/*) queda
# sin usar en el checkout como referencia/rollback, no se borró.
#
# RAPYD_SECRET_KEY es secreto: NO usar NEXT_PUBLIC_. Todas las llamadas
# firmadas a Rapyd (creación del checkout y verificación del webhook) se
# hacen server-side (app/lib/rapyd-server.ts).
#
# En pruebas dejá RAPYD_TEST=true (credenciales Sandbox). En producción
# ponelo en false SÓLO cuando el cliente entregue las credenciales de
# Production — Rapyd separa sandbox y production, no se pueden mezclar.
RAPYD_TEST=true
RAPYD_ACCESS_KEY=YOUR_RAPYD_ACCESS_KEY
RAPYD_SECRET_KEY=YOUR_RAPYD_SECRET_KEY_KEEP_SECRET
RAPYD_COUNTRY=CO
RAPYD_CURRENCY=COP

# ─── Pasarela de pago (legacy): PayU WebCheckout ─────────────────────────────
# Ya no está wireada en el checkout — se deja por si hace falta volver atrás.
PAYU_TEST=true
PAYU_MERCHANT_ID=564749
PAYU_ACCOUNT_ID=567318
PAYU_CURRENCY=COP
PAYU_API_KEY=YOUR_PAYU_API_KEY_KEEP_SECRET

# ─── CRM: HubSpot ────────────────────────────────────────────────────────────
# Opcional. Si NO está seteado, el checkout y el newsletter funcionan igual;
# simplemente no se sincroniza nada al CRM (fail-safe).
#
# HUBSPOT_ACCESS_TOKEN es el token de una Private App (HubSpot → Settings →
# Integrations → Private Apps). Es SECRETO: no usar NEXT_PUBLIC_. Scopes
# necesarios: crm.objects.contacts.write y crm.objects.deals.write.
# HUBSPOT_ACCESS_TOKEN=pat-na1-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#
# Opcionales: si querés que los negocios caigan en un pipeline/etapa concretos.
# Si se omiten, HubSpot usa el pipeline y la etapa por defecto de la cuenta.
# HUBSPOT_DEAL_PIPELINE=default
# HUBSPOT_DEAL_STAGE=appointmentscheduled
